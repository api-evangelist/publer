{
  "opencollection": "1.0.0",
  "info": {
    "name": "Publer Jobs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get job status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.publer.com/api/v1/job_status/:job_id",
            "headers": [
              {
                "name": "Publer-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path",
                "description": "ID of the job to check"
              }
            ]
          },
          "docs": "Check the status of an asynchronous job, including URL media uploads"
        }
      ]
    }
  ],
  "bundled": true
}